{
  "uid": "churn-api",
  "title": "Churn API \u2014 service & model",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "ml",
    "churn"
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Service health (SLOs)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/s by status",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(churn_http_requests_total{route=~\"/v1/.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error ratio (SLO budget 0.5%)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "churn:error_ratio:rate5m",
          "legendFormat": "error ratio"
        },
        {
          "refId": "B",
          "expr": "vector(0.005)",
          "legendFormat": "SLO"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "/v1/predict latency",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(churn_http_request_duration_seconds_bucket{route=\"/v1/predict\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(churn_http_request_duration_seconds_bucket{route=\"/v1/predict\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(churn_http_request_duration_seconds_bucket{route=\"/v1/predict\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pods up / model loaded",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"churn-api\"})",
          "legendFormat": "pods up"
        },
        {
          "refId": "B",
          "expr": "sum(churn_model_loaded)",
          "legendFormat": "pods with model"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Model behaviour",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Predictions/s by risk band",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (risk_band) (rate(churn_predictions_total[5m]))",
          "legendFormat": "{{risk_band}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Mean churn score: now vs 7 days ago",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "churn:score_mean:1h",
          "legendFormat": "last 1h"
        },
        {
          "refId": "B",
          "expr": "churn:score_mean:1h offset 7d",
          "legendFormat": "same time last week"
        }
      ]
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Score distribution",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(churn_prediction_score_bucket[10m]))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Serving model versions (canary visible here)",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_version) (rate(churn_predictions_total[5m]))",
          "legendFormat": "{{model_version}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Input: tenure_months median",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(churn_feature_value_bucket{feature=\"tenure_months\"}[1h])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Input: monthly_charges median",
      "gridPos": {
        "x": 8,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(churn_feature_value_bucket{feature=\"monthly_charges\"}[1h])))",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Ground-truth feedback received",
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (churned) (increase(churn_feedback_total[1h]))",
          "legendFormat": "churned={{churned}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}